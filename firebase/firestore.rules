rules_version = '2';

// Locked down by default: client SDKs can't read or write anything until you
// add rules for specific collections. Server code using the Admin SDK
// (e.g. Cloud Functions) bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
