{
  "name": "tempercraft",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run tauri --workspace @tempercraft/desktop -- dev",
    "build": "npm run tauri --workspace @tempercraft/desktop -- build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "emulators": "firebase emulators:start --project demo-tempercraft"
  },
  "engines": {
    "node": ">=22"
  }
}
